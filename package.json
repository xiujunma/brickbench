{
  "name": "brickbench",
  "private": true,
  "version": "0.1.0",
  "description": "A browser-based 3D brick building workshop.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4"
  },
  "scripts": {
    "dev": "bunx --bun vite",
    "build": "bun run typecheck && bun run ldraw --if-missing && bunx --bun vite build",
    "preview": "bunx --bun vite preview",
    "agent": "bun agent/main.ts",
    "typecheck": "bun check -p tsconfig.json && bun check -p tsconfig.test.json && bun check -p tsconfig.node.json && bun check -p tsconfig.scripts.json && bun check -p tsconfig.electron.json",
    "ldraw": "bun scripts/ldraw/build.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "coverage": "bun test --coverage",
    "e2e": "bunx --bun playwright test",
    "desktop": "bun scripts/desktop.ts start",
    "desktop:dist": "bun scripts/desktop.ts dist",
    "e2e:desktop": "bun scripts/desktop.ts build && bunx --bun playwright test -c playwright.desktop.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@zip.js/zip.js": "2.24.0",
    "jspdf": "^4.2.1",
    "mediabunny": "1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "three-gpu-pathtracer": "0.0.28",
    "three-mesh-bvh": "0.9.18",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "^1.65.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "44.10.2",
    "electron-builder": "26.18.0",
    "fast-png": "^6.4.0",
    "vite": "^8.3.7"
  }
}
