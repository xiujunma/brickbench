# Response headers for hosting on Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).
# The /* block also applies to `vite preview`, so the browser tests in CI run under the same policy.
# connect-src lets the Agent panel reach the agent bridge on the visitor's own computer.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; media-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' ws://127.0.0.1:* http://127.0.0.1:*; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# the app's scripts and styles carry a hash in their names, so they never change
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# library files keep their names when the library is rebuilt
/ldraw/parts/*
  Cache-Control: public, max-age=86400

/ldraw/index.json
  Cache-Control: public, max-age=3600
